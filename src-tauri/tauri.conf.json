{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kimi Companion",
  "version": "1.0.0",
  "identifier": "com.kimicompanion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kimi Companion",
        "decorations": false,
        "width": 960,
        "height": 640,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
